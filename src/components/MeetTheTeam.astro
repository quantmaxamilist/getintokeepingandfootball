---
import TacticsDefs from './TacticsDefs.astro';

interface Coach {
  name: string;
  role: string;
  bio: string;
  photo?: string;
  lead?: boolean;
}

interface Props {
  coaches?: Coach[];
}

// TODO: client to supply headshots (public/coaches/*), names, roles, one-line bios.
const {
  coaches = [
    { name: 'Coach Name', role: 'Goalkeeping Lead', bio: 'One line on their background — added once bios are supplied.', lead: true },
    { name: 'Coach Name', role: 'Development Coach', bio: 'One line on their background — added once bios are supplied.' },
    { name: 'Coach Name', role: 'Camps & 1:1', bio: 'One line on their background — added once bios are supplied.' },
  ],
} = Astro.props;
---

<section id="meet-the-team" class="section-padding relative overflow-hidden bg-base">
  <TacticsDefs />
  <svg class="doodle" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g class="hand" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
      <path d="M120 120 C220 90 240 210 340 175" stroke-dasharray="2 12" />
      <path d="M980 110 C1080 150 1040 250 1130 270" stroke-dasharray="2 12" />
      <circle cx="1040" cy="150" r="15" />
      <path d="M70 330 l24 24 M94 330 l-24 24" />
      <path d="M150 560 C280 520 320 630 460 590" stroke-dasharray="2 12" />
      <circle cx="220" cy="250" r="13" />
    </g>
  </svg>

  <div class="container-narrow relative z-10">
    <div class="mb-14 text-center" data-reveal>
      <span class="pre">the people behind it</span>
      <h2 class="font-display text-3xl font-bold md:text-5xl">Meet the team</h2>
      <svg class="uline hand" viewBox="0 0 260 24" aria-hidden="true"><path d="M6 15 C70 6 200 6 254 13" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" /></svg>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        coaches.map((c) => (
          <article class="coach relative rounded-3xl border border-white/10 bg-panel px-6 pb-6 pt-9 text-center" data-reveal>
            {c.lead && <span class="tag">head coach</span>}
            <div class="ring">
              <div class="ph">
                {c.photo ? <img src={c.photo} alt={c.name} /> : <svg><use href="#tb-player" /></svg>}
              </div>
              {c.lead && (
                <svg class="scribble hand" viewBox="0 0 166 166" aria-hidden="true"><circle cx="83" cy="83" r="78" fill="none" stroke="currentColor" stroke-width="2.4" stroke-dasharray="3 10" /></svg>
              )}
              <span class="bU">UEFA ✓</span>
            </div>
            <h3 class="font-display text-lg font-bold">{c.name}</h3>
            <p class="role">{c.role}</p>
            <p class="mt-1 text-sm text-muted">{c.bio}</p>
          </article>
        ))
      }
    </div>

    <div id="red-rose" class="roseblk mt-16 grid gap-10 rounded-3xl border border-white/10 bg-panel p-8 md:grid-cols-[0.9fr_1.1fr] md:items-center md:p-10" data-reveal>
      <div class="roseimg">
        <span class="note">our grassroots team →</span>
        <span class="rose-badge">
          <img src="/red-rose.png?v=6" alt="Red Rose FC crest" />
        </span>
      </div>
      <div>
        <h3 class="font-display text-3xl font-bold">Red Rose FC</h3>
        <p class="hwsub">from first session to matchday</p>
        <p class="mt-1 max-w-xl text-muted">
          Our own grassroots club — a real pathway from coaching into competitive football. Placeholder copy until the club supplies its story and a team photo.
        </p>
        <a href="/community" class="btn-primary mt-6">Follow the team</a>
      </div>
    </div>
  </div>
</section>

<style>
  .doodle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: #fff;
    opacity: 0.07;
  }
  .hand { filter: url(#rough); }
  .pre {
    font-family: 'Caveat', cursive;
    font-size: 28px;
    color: #fff;
    display: inline-block;
    transform: rotate(-3deg);
  }
  .uline { display: block; margin: 4px auto 0; width: 260px; height: 24px; color: #fff; }

  .coach { padding-top: 2.25rem; }
  .tag {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%) rotate(-4deg);
    font-family: 'Caveat', cursive;
    font-size: 22px;
    color: #fff;
    background: var(--color-base, #0a0b0d);
    padding: 0 10px;
  }
  .ring { position: relative; height: 140px; width: 140px; margin: 0 auto 16px; }
  .ph {
    height: 140px;
    width: 140px;
    border-radius: 50%;
    background: #1a1d22;
    border: 2px solid #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .ph img { height: 100%; width: 100%; object-fit: cover; }
  .ph svg { height: 72px; width: 72px; fill: #565c63; }
  .scribble { position: absolute; inset: -13px; color: #fff; }
  .bU {
    position: absolute;
    bottom: 2px;
    right: 4px;
    background: #fff;
    color: #0a0b0d;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    padding: 3px 7px;
    border-radius: 999px;
    transform: rotate(-6deg);
  }
  .role { font-family: 'Caveat', cursive; font-size: 21px; color: #dfe3e6; margin-top: 2px; }

  .roseimg {
    position: relative;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rose-badge {
    display: block;
    height: 160px;
    width: 160px;
  }
  .rose-badge img {
    height: 160px;
    width: 160px;
    object-fit: contain;
    object-position: center;
    display: block;
    transform: scale(1.42);
    transform-origin: center center;
    filter: drop-shadow(0 16px 40px rgba(0, 0, 0, 0.5));
  }
  .note {
    position: absolute;
    top: -32px;
    left: 8px;
    font-family: 'Caveat', cursive;
    font-size: 26px;
    color: #fff;
    transform: rotate(-5deg);
  }
  .hwsub { font-family: 'Caveat', cursive; font-size: 24px; color: #dfe3e6; margin-top: 4px; }

  @media (prefers-reduced-motion: reduce) {
    .hand { filter: none; }
  }
</style>
