---
import { site } from '../data/site';
---

<section class="section-padding">
  <div class="container-narrow">
    <p class="eyebrow mb-3" data-reveal>Straight from the pitch</p>
    <h2 class="mb-8 font-display text-3xl font-bold md:text-4xl" data-reveal>Follow the action</h2>
    {
      site.facebookUrl ? (
        <div class="overflow-hidden rounded-xl border border-white/10 bg-panel" data-reveal>
          <iframe
            title="Facebook Page Plugin"
            src={`https://www.facebook.com/plugins/page.php?href=${encodeURIComponent(site.facebookUrl)}&tabs=timeline&width=500&height=500&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true`}
            width="100%"
            height="500"
            style="border:none;overflow:hidden"
            scrolling="no"
            frameborder="0"
            allow="encrypted-media"
            allowfullscreen={true}
          ></iframe>
        </div>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
          {
            [1, 2, 3, 4, 5, 6].map((n) => (
              <div class="aspect-square rounded-xl border border-white/10 bg-panel2 p-6">
                <p class="text-xs uppercase tracking-widest text-muted">Social placeholder {n}</p>
                <p class="mt-2 text-sm text-grey-light">TODO: Add Facebook URL in site.ts to load live feed, or Instagram embed later.</p>
              </div>
            ))
          }
        </div>
      )
    }
  </div>
</section>
