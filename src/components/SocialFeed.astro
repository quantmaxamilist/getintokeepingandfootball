---
import { site } from '../data/site';

// Facebook Page Plugin (timeline) — live feed of the page's most recent posts.
// Renders automatically once `facebookUrl` is set in src/data/site.ts.
const feedSrc = site.facebookUrl
  ? `https://www.facebook.com/plugins/page.php?href=${encodeURIComponent(site.facebookUrl)}&tabs=timeline&width=500&height=720&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true`
  : '';
---

<section class="section-padding">
  <div class="container-narrow">
    <div class="grid items-start gap-10 md:grid-cols-2 md:gap-14">
      <div data-reveal>
        <p class="eyebrow mb-3">Straight from the pitch</p>
        <h2 class="mb-4 font-display text-3xl font-bold md:text-4xl">Follow the action</h2>
        <p class="mb-8 max-w-md text-muted">
          Our latest posts, straight from Facebook — sessions, matchdays, holiday camps and Red Rose FC updates, live as they happen.
        </p>
        {
          site.facebookUrl && (
            <a href={site.facebookUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
              Follow us on Facebook
            </a>
          )
        }
      </div>

      <div data-reveal>
        {
          feedSrc ? (
            <div class="mx-auto w-full max-w-[500px] overflow-hidden rounded-2xl border border-white/10 bg-panel">
              <iframe
                title="Get Into Keeping & Football — Facebook feed"
                src={feedSrc}
                width="100%"
                height="720"
                style="border:none;overflow:hidden"
                scrolling="no"
                frameborder="0"
                loading="lazy"
                allow="encrypted-media"
                allowfullscreen={true}
              />
            </div>
          ) : (
            <div class="mx-auto flex w-full max-w-[500px] flex-col items-center justify-center rounded-2xl border border-dashed border-white/20 bg-panel2 p-10 text-center" style="min-height:420px">
              <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="mb-4 text-muted">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <path d="M15 8h-1.5A1.5 1.5 0 0 0 12 9.5V12m-2 0h4m-2 0v5" />
              </svg>
              <p class="text-sm font-semibold uppercase tracking-widest text-muted">Live feed ready</p>
              <p class="mt-2 max-w-xs text-sm text-grey-light">
                Add the Facebook page URL to <code class="text-white">facebookUrl</code> in <code class="text-white">site.ts</code> and the most-recent posts load here automatically.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
