---
import type { UtilityIcon } from '../data/site';

interface Props {
  name: UtilityIcon;
  class?: string;
}

const { name, class: className = 'h-6 w-6 text-accent' } = Astro.props;
const stroke = 'currentColor';
const sw = 1.8;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" class={className} aria-hidden="true">
  {name === 'glove' && (
    <>
      <path d="M18 10v14c0 4 2 8 6 10 4-2 6-6 6-10V10" stroke={stroke} stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" />
      <path d="M14 18v8M22 8v16M30 12v12" stroke={stroke} stroke-width={sw} stroke-linecap="round" />
    </>
  )}
  {name === 'football' && (
    <>
      <circle cx="24" cy="24" r="14" stroke={stroke} stroke-width={sw} />
      <path d="M24 10l4 8-4 6-4-6 4-8zM14 28l8-2 6 6M34 28l-8-2-6 6" stroke={stroke} stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {name === 'tot' && (
    <>
      <circle cx="24" cy="14" r="6" stroke={stroke} stroke-width={sw} />
      <path d="M12 38c0-6 5-10 12-10s12 4 12 10" stroke={stroke} stroke-width={sw} stroke-linecap="round" />
    </>
  )}
  {name === 'camp' && (
    <>
      <path d="M10 34l14-20 14 20H10z" stroke={stroke} stroke-width={sw} stroke-linejoin="round" />
      <path d="M24 14v8M20 22h8" stroke={stroke} stroke-width={sw} stroke-linecap="round" />
    </>
  )}
  {name === 'whistle' && (
    <>
      <circle cx="16" cy="24" r="6" stroke={stroke} stroke-width={sw} />
      <path d="M22 24h14l4 4-4 4H22" stroke={stroke} stroke-width={sw} stroke-linejoin="round" />
    </>
  )}
  {name === 'star' && (
    <path d="M24 8l4 10h10l-8 6 3 10-9-6-9 6 3-10-8-6h10l4-10z" stroke={stroke} stroke-width={sw} stroke-linejoin="round" />
  )}
  {name === 'shield' && (
    <path d="M24 6l14 5v11c0 9-6 15-14 18-8-3-14-9-14-18V11l14-5z" stroke={stroke} stroke-width={sw} stroke-linejoin="round" />
  )}
  {name === 'heart' && (
    <path d="M24 38s-12-7-12-16a7 7 0 0112-5 7 7 0 0112 5c0 9-12 16-12 16z" stroke={stroke} stroke-width={sw} stroke-linejoin="round" />
  )}
  {name === 'shirt' && (
    <>
      <path d="M16 14l8-4 8 4v22H16V14z" stroke={stroke} stroke-width={sw} stroke-linejoin="round" />
      <path d="M16 14l-4 6v6l4-2M32 14l4 6v6l-4-2" stroke={stroke} stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {name === 'cart' && (
    <>
      <circle cx="18" cy="36" r="3" stroke={stroke} stroke-width={sw} />
      <circle cx="32" cy="36" r="3" stroke={stroke} stroke-width={sw} />
      <path d="M8 10h4l4 18h16l4-14H14" stroke={stroke} stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {name === 'map-pin' && (
    <>
      <path d="M24 6c-6 0-10 4.5-10 10 0 7.5 10 18 10 18s10-10.5 10-18c0-5.5-4-10-10-10z" stroke={stroke} stroke-width={sw} stroke-linejoin="round" />
      <circle cx="24" cy="16" r="3" stroke={stroke} stroke-width={sw} />
    </>
  )}
  {name === 'play' && (
    <path d="M18 14l16 10-16 10V14z" stroke={stroke} stroke-width={sw} stroke-linejoin="round" />
  )}
</svg>
