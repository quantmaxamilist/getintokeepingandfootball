---
import { site, venueLine } from '../data/site';
import Logo from './Logo.astro';
import TacticsDefs from './TacticsDefs.astro';

interface Props {
  videoSrc?: string;
  posterSrc?: string;
}

const { videoSrc = '', posterSrc = '' } = Astro.props;
---

<section class="relative flex min-h-[100svh] items-center justify-center overflow-hidden bg-base">
  <TacticsDefs />
  {
    videoSrc ? (
      <>
        {/* Media of under-18s requires parental consent covering website use — client is responsible. */}
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={posterSrc || undefined}
          controlsList="nodownload"
          disablePictureInPicture
          class="absolute inset-0 h-full w-full object-cover"
        >
          <source src={videoSrc} type="video/mp4" />
        </video>
        {/* dim wash keeps the video subtle & the headline legible — tune 60–80 to taste */}
        <div class="absolute inset-0 bg-base/70"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-base/30 via-transparent to-base"></div>
      </>
    ) : (
      <>
        <div class="absolute inset-0 bg-gradient-to-b from-panel via-base to-base"></div>
        <div class="stadium-light absolute -left-1/4 top-0 h-[120%] w-1/2 rotate-12 bg-gradient-to-r from-white/10 to-transparent blur-3xl"></div>
        <div class="stadium-light absolute -right-1/4 top-1/4 h-full w-1/2 -rotate-12 bg-gradient-to-l from-white/8 to-transparent blur-3xl" style="animation-delay: 2s"></div>
        <div class="absolute inset-0 bg-base/50"></div>
      </>
    )
  }

  {/* hand-drawn tactics-board doodles */}
  <svg class="doodle" viewBox="0 0 1200 660" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g class="hand" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
      <path d="M120 120 C220 90 240 210 340 175" stroke-dasharray="2 12" />
      <path d="M980 100 C1080 140 1040 240 1130 260" stroke-dasharray="2 12" />
      <circle cx="1040" cy="150" r="15" />
      <path d="M70 330 l24 24 M94 330 l-24 24" />
      <path d="M150 540 C280 500 320 610 460 570" stroke-dasharray="2 12" />
      <circle cx="220" cy="250" r="13" />
    </g>
  </svg>

  {/* LEFT — Our coaches */}
  <a class="anno anno-left" href="#meet-the-team" aria-label="Meet the coaches">
    <span class="hw hw-lg" style="transform:rotate(4deg)">Our coaches</span>
    <span class="coaches">
      <span class="coachC"><svg><use href="#tb-player" /></svg></span>
      <span class="coachC"><svg><use href="#tb-player" /></svg></span>
      <span class="coachC"><svg><use href="#tb-player" /></svg></span>
    </span>
    <span class="hw hw-sm meet" style="transform:rotate(-3deg)">
      meet the coaches
      <svg width="40" height="22" class="hand" aria-hidden="true"><g fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><path d="M4 11 L32 11" /><path d="M32 11 l-8 -6 M32 11 l-8 6" /></g></svg>
    </span>
  </a>

  {/* RIGHT — Our team (Red Rose) */}
  <a class="anno anno-right" href="#red-rose" aria-label="Red Rose FC — our team">
    <span class="team-wrap">
      <svg class="arrow-in hand" aria-hidden="true"><use href="#tb-arrow" /></svg>
      <span class="rose">
        <img src="/red-rose.png?v=8" alt="Red Rose FC" width="118" height="118" />
      </span>
    </span>
    <span class="hw hw-lg" style="transform:rotate(-6deg)">Our team</span>
  </a>

  <div class="relative z-10 mx-auto max-w-4xl px-5 py-32 text-center">
    <div class="mb-8 flex justify-center" data-reveal>
      <Logo variant="hero" />
    </div>
    <p class="eyebrow mb-4" data-reveal>UEFA-QUALIFIED · NORTH WEST ENGLAND</p>
    <h1 class="mb-6 font-display text-4xl font-bold leading-tight md:text-6xl lg:text-7xl" data-reveal>
      Get into keeping.<br /><span class="text-accent">Get into football.</span>
    </h1>
    <p class="mx-auto mb-10 max-w-2xl text-lg text-muted" data-reveal>
      <img src="/crests/uefa.png?v=1" alt="UEFA" class="eyebrow-badge" />
      UEFA-qualified coaching across {venueLine}<svg class="eng-flag" viewBox="0 0 30 18" role="img" aria-label="England"><rect width="30" height="18" fill="#fff" /><rect x="12" width="6" height="18" fill="#ce1124" /><rect y="6" width="30" height="6" fill="#ce1124" /></svg>
      Tots, Groups, Camps, 1:1 and Academy pathways.
    </p>
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row" data-reveal>
      <a href="/contact" class="btn-primary">{site.ctaPrimary}</a>
      <a href="/memberships" class="btn-ghost-light">{site.ctaSecondary}</a>
    </div>

    {/* mobile-only "Our coaches / Our team" — the desktop versions are absolutely positioned and hidden below 1024px */}
    <div class="mobile-anno mt-12 flex items-start justify-center gap-12 lg:hidden" data-reveal>
      <a href="#meet-the-team" class="flex flex-col items-center gap-2" aria-label="Meet the coaches">
        <span class="coaches">
          <span class="coachC"><svg><use href="#tb-player" /></svg></span>
          <span class="coachC"><svg><use href="#tb-player" /></svg></span>
          <span class="coachC"><svg><use href="#tb-player" /></svg></span>
        </span>
        <span class="hw hw-sm" style="transform:rotate(-3deg)">Our coaches</span>
      </a>
      <a href="#red-rose" class="flex flex-col items-center gap-2" aria-label="Red Rose FC — our team">
        <span class="rose-m"><img src="/red-rose.png?v=8" alt="Red Rose FC" width="70" height="70" /></span>
        <span class="hw hw-sm" style="transform:rotate(3deg)">Our team</span>
      </a>
    </div>
  </div>
</section>

<style>
  .doodle {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: #fff;
    opacity: 0.08;
  }
  .hand { filter: url(#rough); }
  .hw { font-family: 'Caveat', cursive; color: #fff; line-height: 0.9; }
  .hw-lg { font-size: 46px; font-weight: 700; }
  .hw-sm { font-size: 23px; font-weight: 600; opacity: 0.92; }

  .anno {
    position: absolute;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    cursor: pointer;
  }
  .anno-left { left: 4%; top: 39%; }
  .anno-right { right: 5%; top: 42%; }

  .arrow { width: 140px; height: 104px; color: #fff; }
  .team-wrap { position: relative; height: 118px; width: 118px; }
  .arrow-in {
    position: absolute;
    color: #fff;
    width: 150px;
    height: 112px;
    left: -108px;
    top: -150px;
    transform: rotate(16deg) scale(1.06);
    pointer-events: none;
  }
  .rose {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 118px;
    width: 118px;
  }
  .rose img {
    height: 118px;
    width: 118px;
    object-fit: contain;
    object-position: center;
    display: block;
    transform: scale(1.12);
    transform-origin: center center;
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.55));
  }

  .coaches { display: flex; }
  .coachC {
    height: 70px;
    width: 70px;
    border-radius: 50%;
    border: 2px solid #fff;
    background: #1a1d22;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: -14px;
    overflow: hidden;
  }
  .coachC:first-child { margin-left: 0; }
  .coachC svg { height: 36px; width: 36px; fill: #565c63; }
  .meet { display: inline-flex; align-items: center; gap: 6px; }

  /* UEFA badge + England flag inline in the sub-headline */
  .eyebrow-badge {
    display: inline-block;
    height: 1.3em;
    width: auto;
    vertical-align: -0.3em;
    margin-right: 0.35em;
  }
  .eng-flag {
    display: inline-block;
    height: 0.85em;
    width: auto;
    vertical-align: -0.02em;
    margin: 0 0.18em;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18);
  }

  /* mobile-only coaches / team row */
  .rose-m img {
    height: 66px;
    width: 66px;
    object-fit: contain;
    transform: scale(1.05);
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.5));
  }
  .mobile-anno .coachC {
    height: 52px;
    width: 52px;
    margin-left: -12px;
  }
  .mobile-anno .coachC:first-child {
    margin-left: 0;
  }
  .mobile-anno .coachC svg {
    height: 28px;
    width: 28px;
  }

  /* keep the hero uncluttered on tablet & mobile */
  @media (max-width: 1023px) {
    .anno { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hand { filter: none; }
  }
</style>
