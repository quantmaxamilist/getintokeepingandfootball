---
import { site } from '../data/site';
---

<section class="bg-panel2 section-padding">
  <div class="container-narrow text-center" data-reveal>
    <h2 class="mb-4 font-display text-3xl font-bold md:text-4xl">Ready to get started?</h2>
    <p class="mx-auto mb-8 max-w-xl text-muted">Book a session or explore memberships — UEFA-qualified coaching across the North West.</p>
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href="/contact" class="btn-primary">{site.ctaPrimary}</a>
      <a href="/memberships" class="btn-ghost">{site.ctaSecondary}</a>
    </div>
  </div>
</section>
