---
import { affiliations } from '../data/site';

const crestMap: Record<string, string> = {
  hglfc: '/crests/hglfc.svg',
  'junior-hoops': '/crests/junior-hoops.svg',
  ramsbottom: '/crests/ramsbottom.svg',
  rossendale: '/crests/rossendale.svg',
};
---

<section class="border-y border-white/10 bg-panel py-6" aria-label="Affiliations">
  <div class="marquee-wrap overflow-hidden">
    <div class="marquee-track flex w-max items-center gap-10 px-4">
      {
        [...affiliations, ...affiliations].map((item) => (
          <div class="flex shrink-0 items-center gap-3">
            {
              crestMap[item.id] ? (
                <img src={crestMap[item.id]} alt="" class="h-12 w-12 rounded-full" width="48" height="48" />
              ) : (
                <span class="flex h-12 min-w-[3rem] items-center justify-center rounded-full border border-white/20 bg-panel2 px-3 font-display text-sm text-accent">
                  {item.initials}
                </span>
              )
            }
            <span class="whitespace-nowrap font-display text-sm tracking-widest text-text/80">{item.name}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
