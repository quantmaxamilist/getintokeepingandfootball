---
import type { Programme } from '../data/programmes';
import Icon from './Icon.astro';

interface Props {
  programme: Programme;
}

const { programme } = Astro.props;
---

<a
  href={`/provision/${programme.slug}`}
  class="group flex flex-col rounded-xl border border-white/10 bg-panel p-6 transition-all hover:-translate-y-1 hover:border-accent/30 hover:shadow-lg"
  data-reveal
>
  <Icon name={programme.icon} class="mb-4 h-10 w-10 text-accent" />
  <h3 class="mb-2 font-display text-xl font-bold">{programme.title}</h3>
  <p class="mb-4 flex-1 text-sm text-muted">{programme.summary}</p>
  <span class="text-sm font-semibold text-accent group-hover:underline">Learn more →</span>
</a>
