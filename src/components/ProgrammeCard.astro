---
import { programmeImages, type Programme } from '../data/programmes';
import Icon from './Icon.astro';

interface Props {
  programme: Programme;
}

const { programme } = Astro.props;
const bg = programmeImages[programme.slug];
---

<a
  href={`/provision/${programme.slug}`}
  class="group relative flex flex-col overflow-hidden rounded-xl border border-white/10 bg-panel p-6 transition-all hover:-translate-y-1 hover:border-accent/30 hover:shadow-lg"
  data-reveal
>
  {
    bg && (
      <>
        <img
          src={bg}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-base/80 transition-colors group-hover:bg-base/75" />
      </>
    )
  }
  <div class="relative z-10 flex flex-1 flex-col">
    <Icon name={programme.icon} class="mb-4 h-10 w-10 text-accent" />
    <h3 class="mb-2 font-display text-xl font-bold">{programme.title}</h3>
    <p class="mb-4 flex-1 text-sm text-text/80">{programme.summary}</p>
    <span class="text-sm font-semibold text-accent group-hover:underline">Learn more →</span>
  </div>
</a>
