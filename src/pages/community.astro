---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import CtaBand from '../components/CtaBand.astro';
import { entities } from '../data/site';
---

<Layout title="Community & CIC | Get Into Keeping & Football" description="Get Into Sport CIC and Red Rose FC — grassroots football and community reinvestment across the North West.">
  <PageShell>
    <section class="section-padding pt-32">
      <div class="container-narrow max-w-3xl">
        <p class="eyebrow mb-3" data-reveal>Community</p>
        <h1 class="mb-6 font-display text-4xl font-bold md:text-5xl" data-reveal>Grassroots, together</h1>
        <p class="mb-12 text-lg text-muted" data-reveal>
          Get Into Keeping & Football is part of a wider family — coaching, community and club working together across the North West.
        </p>

        <article class="mb-10 rounded-xl border border-white/10 bg-panel p-8" data-reveal>
          <h2 class="mb-1 font-display text-2xl font-bold">{entities.cic.name}</h2>
          <p class="mb-4 text-xs uppercase tracking-widest text-muted">{entities.cic.type} · Community Interest Company</p>
          <p class="text-muted">{entities.cic.description}</p>
          <p class="mt-4 text-sm text-muted">
            As a CIC, Get Into Sport reinvests surplus into local grassroots provision — keeping coaching accessible and supporting community sport where it matters most.
          </p>
        </article>

        <article class="rounded-xl border border-white/10 bg-panel p-8" data-reveal>
          <h2 class="mb-4 font-display text-2xl font-bold">{entities.club.name}</h2>
          <p class="text-muted">{entities.club.description}</p>
          {/* optional rose accent: #e02532 */}
          <p class="mt-4 text-sm text-muted">
            Red Rose FC is the grassroots club arm of the Get Into family — developing players on and off the pitch, with pathways from community coaching into competitive football.
          </p>
        </article>
      </div>
    </section>
    <CtaBand />
  </PageShell>
</Layout>
