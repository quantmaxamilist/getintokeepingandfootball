---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import KitShop from '../components/KitShop.astro';
---

<Layout title="Kit Shop | Get Into Keeping & Football" description="Club kit and merchandise — coming soon.">
  <PageShell>
    <section class="section-padding pt-32">
      <div class="container-narrow">
        <p class="eyebrow mb-3" data-reveal>Kit Shop</p>
        <h1 class="mb-4 font-display text-4xl font-bold md:text-5xl" data-reveal>Club kit &amp; merchandise</h1>
        <p class="mb-8 max-w-2xl text-muted" data-reveal>
          The online kit shop is coming soon. Check back for club kit, training wear and merchandise.
        </p>
      </div>
    </section>
    <KitShop />
  </PageShell>
</Layout>
