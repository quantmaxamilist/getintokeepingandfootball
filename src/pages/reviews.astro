---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import ReviewCard from '../components/ReviewCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { reviews, reviewStats } from '../data/reviews';
---

<Layout title="Reviews | Get Into Keeping & Football" description="100% of families recommend us — real Facebook reviews from parents across the North West.">
  <PageShell>
    <section class="section-padding pt-32">
      <div class="container-narrow">
        <p class="eyebrow mb-3" data-reveal>Reviews</p>
        <h1 class="mb-4 font-display text-4xl font-bold md:text-5xl" data-reveal>
          {reviewStats.total} {reviewStats.label}
        </h1>
        <p class="mb-8 max-w-2xl text-muted" data-reveal>
          100% of families recommend us. Here's what parents across the North West say about our coaching.
        </p>

        <div id="reviews-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {reviews.map((r) => (
            <div data-review-source={r.source}>
              <ReviewCard review={r} />
            </div>
          ))}
        </div>
      </div>
    </section>
    <CtaBand />
  </PageShell>
</Layout>
