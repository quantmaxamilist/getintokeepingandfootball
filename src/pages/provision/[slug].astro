---
import Layout from '../../layouts/Layout.astro';
import PageShell from '../../components/PageShell.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getProgrammeBySlug, programmes } from '../../data/programmes';
import { site } from '../../data/site';

export function getStaticPaths() {
  return programmes.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const programme = getProgrammeBySlug(slug!);

if (!programme) {
  return Astro.redirect('/provision');
}
---

<Layout title={`${programme.title} | Get Into Keeping & Football`} description={programme.summary}>
  <PageShell>
    <section class="section-padding pt-32">
      <div class="container-narrow max-w-3xl">
        <Icon name={programme.icon} class="mb-6 h-12 w-12 text-accent" />
        <p class="eyebrow mb-3" data-reveal>Programme</p>
        <h1 class="mb-6 font-display text-4xl font-bold md:text-5xl" data-reveal>{programme.title}</h1>
        <p class="mb-8 text-lg text-muted" data-reveal>{programme.intro}</p>
        <h2 class="mb-4 font-display text-xl font-bold" data-reveal>What's included</h2>
        <ul class="mb-10 space-y-2 text-muted" data-reveal>
          {programme.included.map((item) => (
            <li class="flex gap-3"><span class="text-accent">→</span>{item}</li>
          ))}
        </ul>
        <a href="/contact" class="btn-primary" data-reveal>{site.ctaPrimary}</a>
      </div>
    </section>
    <CtaBand />
  </PageShell>
</Layout>
